{
  "name": "diabase",
  "version": "0.0.0",
  "private": true,
  "description": "Diabase: a Markdown-native, everything-is-a-plugin knowledge base with a generative UI block engine",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "plugins/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @diabase/app",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "happy-dom": "^21.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
